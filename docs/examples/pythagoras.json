{
  "version": "1",
  "title": "The Pythagorean Theorem",
  "scenes": [
    {
      "id": "statement",
      "narration": "Every right triangle hides one relationship between the lengths of its three sides.",
      "objects": [
        {
          "id": "title",
          "type": "text",
          "content": "The Pythagorean Theorem",
          "position": [0, 3],
          "font_size": 42
        },
        {
          "id": "tri",
          "type": "polygon",
          "points": [[-2.5, -1.5], [1.5, -1.5], [1.5, 1.0]],
          "color": "BLUE"
        }
      ],
      "steps": [
        {"action": "write", "target": "title", "duration": 2.0},
        {"action": "create", "target": "tri", "duration": 2.5},
        {"action": "wait", "duration": 1.5}
      ]
    },
    {
      "id": "squares",
      "narration": "Build a square on each of the three sides, and measure the area that each one covers on the page.",
      "objects": [
        {
          "id": "a_square",
          "type": "rectangle",
          "center": [-3.5, 0],
          "width": 2.0,
          "height": 2.0,
          "color": "GREEN"
        },
        {
          "id": "b_square",
          "type": "rectangle",
          "center": [0, 0],
          "width": 2.0,
          "height": 2.0,
          "color": "YELLOW"
        },
        {
          "id": "c_square",
          "type": "rectangle",
          "center": [3.5, 0],
          "width": 2.0,
          "height": 2.0,
          "color": "ORANGE"
        },
        {
          "id": "a_label",
          "type": "mathtex",
          "content": "a^2",
          "position": [-3.5, 2.2],
          "font_size": 40,
          "color": "GREEN"
        },
        {
          "id": "b_label",
          "type": "mathtex",
          "content": "b^2",
          "position": [0, 2.2],
          "font_size": 40,
          "color": "YELLOW"
        },
        {
          "id": "c_label",
          "type": "mathtex",
          "content": "c^2",
          "position": [3.5, 2.2],
          "font_size": 40,
          "color": "ORANGE"
        }
      ],
      "steps": [
        {"action": "create", "target": "a_square", "duration": 1.5},
        {"action": "write", "target": "a_label", "duration": 1.0},
        {"action": "create", "target": "b_square", "duration": 1.5},
        {"action": "write", "target": "b_label", "duration": 1.0},
        {"action": "create", "target": "c_square", "duration": 1.5},
        {"action": "write", "target": "c_label", "duration": 1.0},
        {"action": "wait", "duration": 1.5}
      ]
    },
    {
      "id": "conclusion",
      "narration": "The two smaller areas together exactly fill the largest one, for every right triangle there is.",
      "objects": [
        {
          "id": "equation",
          "type": "mathtex",
          "content": "a^2 + b^2 = c^2",
          "position": [0, 0.6],
          "font_size": 60
        },
        {
          "id": "caption",
          "type": "text",
          "content": "for every right triangle",
          "position": [0, -1.6],
          "font_size": 32,
          "color": "GREY"
        }
      ],
      "steps": [
        {"action": "write", "target": "equation", "duration": 2.5},
        {"action": "indicate", "target": "equation", "duration": 1.5},
        {"action": "write", "target": "caption", "duration": 2.0},
        {"action": "wait", "duration": 1.5}
      ]
    }
  ]
}
